# Applied by scripts/build-curl.sh after devkitPro's switch-curl.patch (ADR 0015):
# CURLOPT_SSL_CIPHER_LIST picks one cipher suite through libnx's SetCipher
# option, and load_capath closes the CA folder when it returns early. It also
# drops CURL_RUN_IFELSE's AC_REQUIRE([AC_RUN_IFELSE]): with autoconf 2.70+
# (Debian bookworm's), that fails every cross build (curl removed it in later
# releases). On a failed verification it reports the TLS service's error and
# the server certificate's key type (RSA, ECDSA P-256 or P-384).

--- a/lib/vtls/libnx.c
+++ b/lib/vtls/libnx.c
@@ -32,6 +32,7 @@
 #ifdef USE_LIBNX
 
 #include <switch.h>
+#include <stdlib.h>
 
 #undef BIT
 
@@ -101,6 +102,36 @@
   return TRUE;
 }
 
+/* Dreadovania: the server certificate's key type, from the chain the TLS
+ * service returned (SslOptionType_GetServerCertChain), by its first key OID. */
+static const char *libnx_peer_key(const u8 *buf, size_t size)
+{
+  static const u8 rsa[] = {0x06, 0x09, 0x2A, 0x86, 0x48, 0x86, 0xF7, 0x0D,
+                           0x01, 0x01, 0x01};
+  static const u8 ec[] = {0x06, 0x07, 0x2A, 0x86, 0x48, 0xCE, 0x3D, 0x02, 0x01};
+  static const u8 p256[] = {0x06, 0x08, 0x2A, 0x86, 0x48, 0xCE, 0x3D, 0x03,
+                            0x01, 0x07};
+  static const u8 p384[] = {0x06, 0x05, 0x2B, 0x81, 0x04, 0x00, 0x22};
+  size_t i;
+  if(!buf || !size)
+    return "no chain";
+  for(i = 0; i + sizeof(rsa) <= size; i++) {
+    if(!memcmp(buf + i, rsa, sizeof(rsa)))
+      return "RSA cert";
+    if(!memcmp(buf + i, ec, sizeof(ec))) {
+      const u8 *curve = buf + i + sizeof(ec);
+      if(i + sizeof(ec) + sizeof(p256) <= size &&
+         !memcmp(curve, p256, sizeof(p256)))
+        return "ECDSA P-256 cert";
+      if(i + sizeof(ec) + sizeof(p384) <= size &&
+         !memcmp(curve, p384, sizeof(p384)))
+        return "ECDSA P-384 cert";
+      return "ECDSA cert";
+    }
+  }
+  return "no chain";
+}
+
 static CURLcode load_capath(struct Curl_easy *data, SslContext *context,
                             const char *path, const bool verifypeer)
 {
@@ -150,8 +181,11 @@
       failf(data, "Error reading ca path file %s",
             tmp_path);
 
-      if(verifypeer)
+      if(verifypeer) {
+        closedir(dir);
         return CURLE_SSL_CACERT_BADFILE;
+      }
+      continue;
     }
 
     rc = sslContextImportServerPki(context, tmpbuf, tmpbuf_size,
@@ -162,8 +196,10 @@
       failf(data, "Error importing ca path file %s - libnx: 0x%X",
             tmp_path, rc);
 
-      if(verifypeer)
+      if(verifypeer) {
+        closedir(dir);
         return CURLE_SSL_CACERT_BADFILE;
+      }
     }
   }
 
@@ -422,6 +458,29 @@
     rc = sslConnectionSetOption(&BACKEND->conn,
                                 SslOptionType_GetServerCertChain, TRUE);
 
+  /* Dreadovania: CURLOPT_SSL_CIPHER_LIST names one cipher suite by its IANA
+   * number (e.g. "0xC02F"), and only that suite is offered ([17.0.0+]). */
+  if(R_SUCCEEDED(rc) && SSL_CONN_CONFIG(cipher_list)) {
+    char *end = NULL;
+    unsigned long suite = strtoul(SSL_CONN_CONFIG(cipher_list), &end, 0);
+    if(!end || *end || !suite || suite > 0xFFFF) {
+      failf(data, "Cipher list must be one IANA cipher suite number");
+      return CURLE_SSL_CIPHER;
+    }
+    if(!hosversionAtLeast(17, 0, 0)) {
+      failf(data, "Choosing a cipher suite needs system version 17.0.0+");
+      return CURLE_SSL_CIPHER;
+    }
+    rc = sslConnectionSetPrivateOption(&BACKEND->conn,
+                                       SslPrivateOptionType_SetCipher,
+                                       (u32)suite);
+    if(R_FAILED(rc)) {
+      failf(data, "Error choosing cipher suite %s - libnx: 0x%X",
+            SSL_CONN_CONFIG(cipher_list), rc);
+      return CURLE_SSL_CIPHER;
+    }
+  }
+
   if(R_SUCCEEDED(rc)) {
     u32 verifyopt = SslVerifyOption_DateCheck;
     if(verifypeer) verifyopt |= SslVerifyOption_PeerCa;
@@ -775,6 +834,10 @@
     return CURLE_OK;
   if(retcode == CURLE_PEER_FAILED_VERIFICATION) {
     rc = sslConnectionGetVerifyCertError(&BACKEND->conn);
+    /* Dreadovania: say why, and what kind of certificate the server sent:
+     * the first key-type OID in the chain is the server's own. */
+    failf(data, "verify 0x%X, %s", rc, libnx_peer_key(BACKEND->certbuf,
+                                                      BACKEND->certbuf_size));
     if(R_VALUE(rc) != MAKERESULT(123, 301) &&
        R_VALUE(rc) != MAKERESULT(123, 303) &&
        R_VALUE(rc) != MAKERESULT(123, 304)) {
